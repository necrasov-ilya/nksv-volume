{
  "name": "nksv-volume",
  "version": "1.0.0",
  "description": "Lightweight file sharing service",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "build:client": "esbuild public/js/theme.ts --bundle --outfile=public/js/theme.js --format=iife --target=es2022 --minify && esbuild public/js/admin.ts public/js/viewer.ts --bundle --outdir=public/js --format=esm --target=es2022 --minify",
    "build:editor": "npm --prefix editor-app ci && npm --prefix editor-app run build",
    "build": "npm run build:client && npm run build:editor",
    "dev:client": "esbuild public/js/theme.ts --bundle --outfile=public/js/theme.js --format=iife --target=es2022 && esbuild public/js/admin.ts public/js/viewer.ts --bundle --outdir=public/js --format=esm --target=es2022 --watch",
    "dev:editor": "npm --prefix editor-app run dev",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc && tsc -p tsconfig.client.json",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:data:http": "node scripts/verify-data.mjs --http"
  },
  "dependencies": {
    "@tabler/icons-webfont": "^3.44.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "nanoid": "^5.0.9",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
